<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF050A1A">

    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NEUROSHIFT"
        android:textColor="#FF00FFCC"
        android:textSize="48sp"
        android:fontFamily="monospace"
        android:textStyle="bold"
        android:letterSpacing="0.15"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.25"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <TextView
        android:id="@+id/highScoreText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="BEST: 0"
        android:textColor="#AA00FFCC"
        android:textSize="20sp"
        android:fontFamily="monospace"
        app:layout_constraintTop_toBottomOf="@id/titleText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="12dp"/>

    <Button
        android:id="@+id/btnPlay"
        android:layout_width="220dp"
        android:layout_height="60dp"
        android:text="▶  PLAY"
        android:textSize="20sp"
        android:fontFamily="monospace"
        android:backgroundTint="#FF6C63FF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="40dp"/>

    <Button
        android:id="@+id/btnLeaderboard"
        android:layout_width="220dp"
        android:layout_height="52dp"
        android:text="🏆  LEADERBOARD"
        android:textSize="16sp"
        android:fontFamily="monospace"
        android:backgroundTint="#FF1E2A4A"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/btnPlay"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <Button
        android:id="@+id/btnQuit"
        android:layout_width="220dp"
        android:layout_height="52dp"
        android:text="✕  QUIT"
        android:textSize="16sp"
        android:fontFamily="monospace"
        android:backgroundTint="#FF1E2A4A"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/btnLeaderboard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="v1.0  •  TAP TO ROTATE GRAVITY"
        android:textColor="#446C63FF"
        android:textSize="12sp"
        android:fontFamily="monospace"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="24dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>